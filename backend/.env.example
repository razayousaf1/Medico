# ============================================================
# Medico API — environment configuration
# Copy to `.env` and fill in your keys:  cp .env.example .env
# ============================================================

# --- Google Gemini --------------------------------------------
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Available models include: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Firestore ---------------------------------------
# Option A (local dev): path to the service-account JSON you
# downloaded from Firebase console -> Project settings -> Service accounts
FIREBASE_CREDENTIALS_PATH=
# Option B (deployment): the same JSON, base64-encoded on one line:
#   base64 -i firebase-service-account.json | tr -d '\n'
FIREBASE_CREDENTIALS_B64=
# Option C (Google Cloud environments with Application Default Credentials)
FIRESTORE_PROJECT_ID=

# If none of the three are set, the API runs against a built-in
# demo dataset (Lahore pharmacies) so you can develop without Firebase.

# --- App -------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=10

# Default map centre used when the browser does not share a location
DEFAULT_LAT=31.5497
DEFAULT_LNG=74.3436
